# -----------------------------------------
# Rubidium Programming Language Reference
# File extension: .rub
# Designed for beginners. Built to scale into real systems programming.
# -----------------------------------------

# =========================================
# EXECUTION MODEL
# =========================================

# Rubidium runs in two phases:

# PHASE 1 — TOP LEVEL
#   Runs top to bottom before main().
#   Creates variables in the global pool.
#   Executes any function calls written at the top level immediately.
#   Defines functions and classes but does NOT run them.

# PHASE 2 — MAIN
#   After top level finishes, the compiler automatically runs fn main().

print("This runs first — top level")

fn main() {
    print("This runs second — main")
}

# =========================================
# MEMORY MODEL
# =========================================

# All variables live in a SHARED GLOBAL POOL.
#
# Rules:
# - Variables are visible everywhere once created.
# - There is no automatic memory management.
# - Memory must be freed manually using .drop().
# - The only exceptions are open() file blocks and loop variables,
#   which are freed automatically at the end of their block.
#
# Think of memory as a shared whiteboard —
# everyone can see and modify it.

# =========================================
# VARIABLES
# =========================================

# Declare with 'let'. Type is optional — Rubidium infers it.

let x = 10
let name = "Rubidium"
let flag = True

# Use 'mut' if you need to reassign the variable later.

let mut counter = 0
counter = 5

# Trying to reassign a non-mut variable is a compile error.

let a = 10
a = 20   # ERROR: a is not mutable

# =========================================
# DATA TYPES
# =========================================

# Integers (signed):
#   i32, i64, i128, i256, i512, i1024, i2048

# Floats:
#   f32, f64, f128, f256, f512, f1024, f2048

# Other:
#   str   — text string
#   bool  — True or False
#   Null  — valid for all types, means "exists but empty"
#   Any   — can hold a value of any type

let a: i32  = 100
let b: f64  = 3.14
let c: str  = "hello"
let d: bool = True
let e: i32  = Null
let f: Any  = "I can be anything!"

# Any can be used when you don't know the type in advance, for functions and return types and such
# Strings are also indexable for existing

let str: str = "Hello, World!"

for i in str.len() {
    print(str.char(i))
}

# It starts a 1 so for this it would print all the characters in str one by one on a new line

# =========================================
# NULL
# =========================================

# Null is a valid value for every type.
# It means the variable exists but holds no data yet.

let x: i32  = Null
let name: str  = Null
let flag: bool = Null

# =========================================
# TYPE CASTING
# =========================================

# Use 'as' to cast between types.

let y: i32 = 5
let large: i64 = y as i64
let f: f64 = 100 as f64

# =========================================
# TYPE CHECKING
# =========================================

# Rubidium checks types at compile time.
# Assigning the wrong type raises a compiler error.

# Example (will NOT compile):
# let val: i32 = 5
# val = "hello"   # ERROR: wrong type

# =========================================
# DEEP COPY RULE
# =========================================

# Every assignment creates a full deep copy.
# There is no borrowing or sharing of values.

let a = [1, 2, 3]
let b = a

b(0).set(999)

print(a)   # [1, 2, 3]  — a is unchanged
print(b)   # [999, 2, 3]

# =========================================
# MATH
# =========================================

# Standard operators:
#   +   addition
#   -   subtraction
#   *   multiplication
#   /   division
#   **  power
#   */  square root (prefix)

let a = 10 + 5       # 15
let b = 10 - 5       # 5
let c = 10 * 5       # 50
let d = 10 / 5       # 2
let e = 2 ** 3       # 8
let f = */16         # 4

# Standard BODMAS precedence applies.

let g = 1 + 2 * 3    # 7
let h = (1 + 2) * 3  # 9

# Negate a value with a leading minus.

let x = 10
let y = -x           # -10

# =========================================
# COMPARISON & LOGIC
# =========================================

# Comparison operators:
#   ==  equal
#   !=  not equal
#   >   greater than
#   <   less than
#   >=  greater than or equal
#   <=  less than or equal

let check: bool = 10 > 5   # True

# Logical operators:
#   and
#   or
#   not

let result: bool = True and not False   # True

# =========================================
# STRINGS
# =========================================

let a: str = "Hello"
let b: str = "World"

# Concatenation — returns a new string.

let c = a + b
let d = a.combine(b)

# String methods:

let length: i64 = a.len()         # character count if the str was "hello" it would return 5 
let found: bool = a.has("ell")    # True

# Type conversion from string:

let num_str: str = "123"
let i: i32 = num_str.to(i32)
let f: f64 = num_str.to(f64)

# Type conversion to string:

let n: i32 = 42
let s: str = n.to(str)

# String interpolation using i"":

let name = "Rubidium"
print(i"Hello {name}")   # Hello Rubidium

# =========================================
# COLLECTIONS
# =========================================

# All three collection types (list, index, dict)
# require 'mut' if you want to modify them.

# -----------------------------------------
# LIST
# -----------------------------------------

# An ordered sequence. Zero-indexed.

let mut my_list: list = ["hello", 2.5, True]

# Access by index:

print(my_list(0))   # hello

# Mutate an item using .set():

my_list(0).set("changed")

# Append a new item using .add():

my_list().add("new_item")

# -----------------------------------------
# INDEX
# -----------------------------------------

# A flat key-value map.
# Keys and values can be any type.
# Each key stores exactly one value.

let mut my_index: index = [
    "name": "Rubidium",
    1: "one",
    2.5: "float key"
]

# Access by key:

print(my_index("name"))   # Rubidium

# Mutate a value using .set():

my_index("name").set("updated")

# Add a new key-value pair using .add():
# If the key already exists, this will error.

my_index().add("new_key", 99)

# -----------------------------------------
# DICT
# -----------------------------------------

# A key-value map where each key holds
# a collection of multiple values.

let mut my_dict: dict = {
    "scores" = [10, 20, 30],
    "names"  = ["alice", "bob"]
}

# Access a specific value inside a key:
# dict(key, index)

print(my_dict("scores", 1))   # 20

# Mutate a value using .set():

my_dict("scores", 1).set(999)

# Add a value to an existing key's collection:

my_dict("scores").add(40)

# Add a new top-level key:
# The new key is created with value Null.

my_dict().add("new_key")

# =========================================
# PRINT & INPUT
# =========================================

# print() — outputs text and moves to a new line.

print("Hello, Rubidium!")
print(x)
print(i"Value is {x}")
print("Count: " + x)

# println() — overwrites the current console line.
# Calling it again replaces the previous output.

println("Loading...")
println("Done!")
# The console shows: Done!

# input() — reads a line of text from the user.

let user: str = input("Enter your name: ")

# =========================================
# FILES
# =========================================

# Open a file using 'open() as'.
# The file automatically closes at the end of the block.
# Any variables created inside the block persist,
# but the file handle is gone after the closing brace.

open("data.txt") as file {

    file.write("Hello")        # overwrite entire file
    file.add(" World")      # add to end of file

    let data = file.read()     # read entire file
    print(data)

    let line = file.readln(3)  # read a specific line
    print(line)

    file.writeln(2, "Updated") # overwrite a specific line
}

# Iterate over a file line by line:

open("data.txt") as file {

    for line in file {
        print(line)
    }
}

# File utility functions (used outside of open blocks):

file.exists("data.txt")              # returns bool
file.new("data.txt")                 # create a new file
file.delete("old.txt")               # delete a file
file.rename("old.txt", "new.txt")    # rename a file
file.copy("save.txt", "backup.txt")  # copy a file

# File errors can be caught with try/error:

try {

    open("missing.txt") as file {
        print(file.read())
    }

} error {

    print("File error: " + error)
}

# =========================================
# MEMORY — DROPPING VARIABLES
# =========================================

# .drop() frees a variable's memory immediately.
# The variable no longer exists after being dropped.
# Collections recursively free all nested data.

let val = 42
val.drop()

let mut items: list = [1, 2, 3]
items.drop()

# =========================================
# CONDITIONALS
# =========================================

let x = 7

if x == 7 {
    print("lucky seven")
} else if x > 10 {
    print("big number")
} else {
    print("something else")
}

# =========================================
# LOOPS
# =========================================

# While loop:

let mut count = 0

while count < 5 {
    print(count)
    count = count + 1
}

# -----------------------------------------
# RANGE LOOP
# -----------------------------------------

# range(start, end) — end is exclusive.
#
# The loop variable is local to the loop only.
# It can be named anything and is automatically
# dropped when the loop ends.

for i in range(1, 10) {

    if i == 5 {
        break
    }

    print(i)
}

# The loop variable name is not special.

for value in range(1, 10) {
    print(value)
}

for banana in range(1, 10) {
    print(banana)
}

# -----------------------------------------
# COLLECTION ITERATION
# -----------------------------------------

# Lists, indexes, dicts, and files can be
# used directly in for loops.

# Loop variables are always local to the loop
# and are automatically dropped after execution.

let items: list = [10, 20, 30]

for item in items {
    print(item)
}

for number in items {
    print(number)
}

# -----------------------------------------
# INDEX ITERATION
# -----------------------------------------

# Iterating an index yields keys.

let table: index = [
    "name": "Rubidium",
    "lang": "Programming"
]

for key in table {
    print(key)
    print(table(key))
}

# -----------------------------------------
# DICT ITERATION
# -----------------------------------------

# Iterating a dict yields keys.

let scores: dict = {
    "players" = ["Alice", "Bob"],
    "points" = [10, 20]
}

for key in scores {
    print(key)
    print(scores(key, 0))
}

# -----------------------------------------
# FILE ITERATION
# -----------------------------------------

# Iterating a file yields lines.
# The file handle remains valid only inside
# the open block scope.

open("data.txt") as file {

    for line in file {
        print(line)
    }
}

# -----------------------------------------
# BREAK & CONTINUE
# -----------------------------------------

# break exits the loop immediately.

for i in range(1, 10) {

    if i == 5 {
        break
    }

    print(i)
}

# continue skips the current iteration.

for i in range(1, 10) {

    if i == 5 {
        continue
    }

    print(i)
}

# -----------------------------------------
# ITERATION NOTES
# -----------------------------------------

# - Loop variable names can be anything
# - Loop variables are local to the loop scope
# - Loop variables are automatically dropped after the loop
# - Lists yield values
# - Indexes yield keys
# - Dicts yield keys
# - Files yield lines
# - User-defined classes cannot define custom iteration behavior

# =========================================
# FUNCTIONS
# =========================================

# Functions create an isolated scope.
# Variables declared inside a function are not in the global pool.

# Basic function:

fn greet() {
    print("Hello!")
}

# With parameters:

fn add(a: i32, b: i32) -> i32 {
    return a + b
}

let result = add(2, 3)   # 5

# Return type is optional.
# A function with no return type returns nothing.

fn log(msg: str) {
    print(i"[LOG] {msg}")
}

# =========================================
# ERROR HANDLING
# =========================================

# Use try/error to catch runtime errors.
# The error variable holds the error message as a string.

try {

    let bad: i32 = 10 / 0

} error {

    print("Error: " + error)
}

# try/error works with file operations too (see FILES section).

# =========================================
# CLASSES
# =========================================

# A class is a self-contained object template.
# There is no 'self' keyword — class variables are
# accessed directly from inside the class.

class player() {

    let mut health: i32 = 100
    let mut name: str   = "unnamed"
    let mut scores: list = [0, 0, 0]

    fn greet() {
        print(i"Hi, I am {name}")
    }

    fn take_damage(amount: i32) {
        health = health - amount
    }

    fn reset_scores() {
        # Inside the class, collection fields are accessed directly
        # without the instance name — just like non-collection fields.
        scores(0).set(0)
        scores(1).set(0)
        scores(2).set(0)
        scores().add(0)
    }
}

# Create an instance:

let mut p = player()

# Read class fields:

print(p.health)   # 100

# Mutate a non-collection field using =:
# The instance must be declared with mut.

p.health = 80
p.name   = "Alice"

# Mutate a collection field using .set():
# From outside the class, prefix with the instance name.

p.scores(0).set(99)

# From inside a class method, access directly without the instance name.
# See reset_scores() in the class definition above.

# Append to a collection field using .add():

p.scores().add(50)

# Call a class method:

p.greet()
p.take_damage(10)

# Mutation rules:
# - If the instance is immutable (no mut), nothing can be changed.
# - If the instance is mutable (mut), only fields declared
#   with 'mut' inside the class can be changed.

class locked() {
    let value: i32 = 42     # can never be changed from outside
}

let mut obj = locked()
obj.value = 99   # ERROR: value is not declared mut

# =========================================
# THREADING
# =========================================

# Rubidium supports real POSIX hardware threads.

use thread

fn task_one() {
    print("Task one done")
}

fn task_two() {
    print("Task two done")
}

fn run() {

    # thread(function(), id) — runs function asynchronously.
    # Thread IDs are integers, like timer IDs.
    # A thread ID can only be reused after that thread has finished.

    thread(task_one(), 1)
    thread(task_two(), 2)

    # thread.wait(id, ...) — blocks until all listed threads finish.

    thread.wait(1, 2)

    # thread.running(id) — returns True if the thread is still running.

    let still_going: bool = thread.running(1)
}

# =========================================
# RANDOM
# =========================================

use random

# Generate a random number in a range.
# random(min, max, type)

let r_int: i32 = random(0, 10, i32)
let r_flt: f32 = random(0, 1, f32)

# Shuffle a list in place:

let mut items: list = [1, 2, 3, 4, 5]
random.shuffle(items)

# Pick a random value from a collection:

random.choice(items)

let mut my_index: index = ["a": 1, "b": 2]
random.choice(my_index)

let mut my_dict: dict = { "scores" = [10, 20, 30] }
random.choice(my_dict)
random.choice(my_dict("scores"))

random.seed("seed")

# to set the starting seed

# =========================================
# TIME
# =========================================

use time

# Pause execution for a number of seconds.

time.wait(5)

# Named timers — identified by integer IDs,
# the same way thread IDs work.
# Multiple timers can run simultaneously.

# Start a timer.
# Optionally specify a float return type for timer_read.
# Defaults to f32 if no type is given.

time.timer_start(1)         # returns f32 by default
time.timer_start(2, f64)    # returns f64

# Pause a running timer (keeps elapsed time):

time.timer_pause(1)

# Stop a timer (resets it):

time.timer_stop(1)

# Read elapsed time in seconds.fractional seconds.
# Returns the float type specified when the timer was started.

let elapsed = time.timer_read(1)

# =========================================
# OS
# =========================================

use os

# Start a hidden terminal session with an integer ID.
# On Linux this opens a bash shell.
# On Windows this opens cmd or powershell depending on your system.
# The terminal is not visible — it is for Rubidium only.

os.start(1)

# Run a command in a terminal session:

os.run(1, "ls -a")

# Capture command output:

let output = os.run(1, "echo hello")

# Pass input automatically when the command asks for it:
# The third argument is sent as soon as input is requested.

let result = os.run(1, "sudo apt update", "y")

# Drop a terminal session to free its resources:

os(1).drop()

# =========================================
# FFI — FOREIGN FUNCTION INTERFACE
# =========================================

use FFI

# Load a compiled shared library (.so on Linux, .dll on Windows).
# The path starts from the folder your .rub file is in.

let c_lib = FFI("libs/mylib.so")

# Bind a foreign function using fn with the FFI handle as the first identifier.
# This does NOT define a new Rubidium function.
# It creates a binding to the symbol inside the library.

fn c_lib my_c_func(msg: str) -> i32

# Call the bound function like a normal function:

c_lib.my_c_func("hello from Rubidium")

# Binding rules:
# - The first identifier must be an FFI handle.
# - The second identifier is the exact symbol name inside the library.
# - The type signature is used for ABI mapping and compile-time type checking.
# - Bindings are resolved at load time.
# - Compatible with C, C++, C#, and Rust shared libraries.

