# -----------------------------------------
# INDEX
# -----------------------------------------

# A flat key-value map.
# Keys and values can be any type.
# Each key stores exactly one value.

let mut my_index: index = [
    "name": "Rubidium",
    1: "one",
    2.5: "float key"
]

# Access by key:

print(my_index("name"))   # Rubidium

# Mutate a value using .set():

my_index("name").set("updated")

# Add a new key-value pair using .add():
