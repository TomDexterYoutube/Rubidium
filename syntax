# MAIN ENTRY POINT
# =========================================

# The compiler always looks for fn main() as the program entry point.
# It runs after all top-level code has finished.

fn main() {
    print("Welcome to Rubidium!")
}

# =========================================
# QUICK REFERENCE
# =========================================

# Syntax basics:
#   - Statements end with a newline. Semicolons are not required.
#   - Blocks use braces { }
#   - Comments use #
#   - Strings use double quotes
#   - Boolean values are True and False
#   - Logical operators are: and, or, not
#   - Type casting uses: as
#   - String interpolation uses: i"text {variable}"
#   - Square root uses: */value

# Memory:
#   - All assignments are deep copies
#   - Variables are global by default
#   - Functions, classes, and imports create isolated scopes
#   - Memory must be freed manually with .drop()
#   - Exceptions: open() blocks and loop variables are freed automatically

# Types:
#   - Type checking is done at compile time
#   - Null is valid for all types
#   - Collections always require mut to be modified

# Collections summary:
#   list  — ordered sequence, zero-indexed, one type of value per slot
#   index — flat key->value map, mixed key and value types allowed
#   dict  — key->collection map, each key holds multiple values
#   for all of these you can use .has() for keys and values
