fn main() {

    print("Welcome to Rubidium!")

    run_class()
    run_threads()
}

# -------------------------------
# FFI
# -------------------------------

# For C, C++, C# and my favorite flavor of pain (the least brain hurt): RUST

let c_file = FFI("data/file.so")

# This loads the shared library into the identifier `c_file`.

# If a function declaration starts with an identifier
# that was created using FFI(...),
# then the compiler treats it as a foreign function binding.

fn c_file printfn(var: str) -> i32

# Meaning:
# - c_file = loaded foreign library
# - printfn = function symbol inside the library
# - (var: str) -> i32 = type signature for ABI mapping and type checking
#
# This does NOT define a normal function.
# It creates a binding to an external function.

# After binding, the function can be called like a normal function.

printfn("hello")

# This executes the bound foreign function from the external library.

# -------------------------------
# NOTES
# -------------------------------

# - FFI libraries are loaded using FFI("path").
# - Bound functions are resolved at compile/load time.
# - The first identifier in the fn statement must be an FFI handle.
# - The second identifier is the symbol name inside the library.
# - The function signature is used for type safety and ABI layout.
# - Statements end with a newline
# - Semicolons are not required
# - Variables can be mutable or immutable
# - Functions support optional return types
# - Math follows standard precedence rules
# - if / else and loops use braces { }
# - Strings use double quotes
# - .drop() immediately frees memory
# - Type checking happens at compile time
# - Boolean values are True and False
# - Logical operators are and, or, and not
# - Error handling uses try/error blocks
