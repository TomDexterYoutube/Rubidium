# -----------------------------------------
# STRING EXAMPLES
# -----------------------------------------

print("A")
print("Hello " + "World")
print("Count: " + 10)
print(i"Hello {10}")

# =========================================
# LISTS (MUST BE MUTABLE)
# =========================================

let mut list = [1,2,3,4,5]

print(list(0))
print(list(1))

# modification examples
list(0).set(999)
list(1).set(888)

# append examples
list().add(6)
list().add(7)

print(list)

# -----------------------------------------
# LIST BEHAVIOR EXPLANATION
# -----------------------------------------

# Lists:
# - stored in heap
# - indexed from 0
# - require mut to modify
# - support add/set operations

# =========================================
# INDEX (MIXED KEYS)
# =========================================

let index = [
    "name": "Rubidium",
    1: "one",
    2.5: "float key"
]

print(index("name"))
print(index(1))
print(index(2.5))

index("name").set("New Name")

# =========================================
# DICTIONARY (STRUCTURED DATA)
# =========================================

let dict = {
    "numbers" = [1,2,3],
    "letters" = ["a", "b", "c"]
}

print(dict("numbers", 0))
print(dict("letters", 2))

dict("numbers", 1).set(999)

# =========================================
# PRINTING (EXTRA DETAIL)
# =========================================

print("Hello")
println("Line mode A")
println("Line mode B")

print("Value: " + 10)
print(i"Value: {10}")

# =========================================
# INPUT
# =========================================

let name = input("Enter your name: ")

print("Hello " + name)

# =========================================
# FILE SYSTEM (HEAVILY EXPLAINED)
# =========================================

open("file.txt") as file {

    # write overwrites file
    file.write("Hello")

    # append adds to end
    file.append(" World")

    # read entire file
    let data = file.read()

    print(data)
}

# -----------------------------------------
# FILE EXPLANATION
# -----------------------------------------

# open() creates a temporary file handle
# automatically closed at block end

# =========================================
# LOOPS (VERY EXPLICIT)
# =========================================

# WHILE LOOP
let mut i = 0

while i < 5 {
    print(i)
    i = i + 1
}

# RANGE LOOP (INCLUSIVE)
for i in range(1, 5) {
    print(i)
}

# OUTPUT:
# 1 2 3 4 5

# LIST LOOP
let items = [10,20,30]

for item in items {
    print(item)
}

# DICT LOOP (KEYS)
let map = {
    "a" = 1,
    "b" = 2
}

for key in map {
    print(map(key))
}

# =========================================
# FUNCTIONS (VERY IMPORTANT SECTION)
# =========================================

fn add(a: i32, b: i32) -> i32 {
    return a + b
}

let result = add(2,3)

# -----------------------------------------
# FUNCTION POOL BEHAVIOR
# -----------------------------------------

fn make() {
    let x = 50
}

make()

print(x)

# OUTPUT:
# 50

# Explanation:
# functions inject variables into global pool

# -----------------------------------------
# RECURSION
# -----------------------------------------

fn count(n: i32) {
    if n > 0 {
        count(n - 1)
    }
}

# =========================================
# CLASSES
# =========================================

class player() {

    let health = 100

    fn hit() {
        print("ouch")
    }
}

let a = player()
let b = player()

print(a.health)
print(b.health)

a.health.set(50)

print(b.health)

# -----------------------------------------
# CLASS EXPLANATION
# -----------------------------------------

# classes:
# - isolate internal structure
# - create separate instances
# - do NOT share memory

# =========================================
# THREADING
# =========================================

fn task() {
    print("task done")
}

thread(task(), 1)
thread(task(), 2)

thread.wait(1,2)

# WARNING:
# no locks exist
# shared variables can be modified simultaneously

# =========================================
# RANDOM
# =========================================

let r = random(0,10,i32)

random.shuffle(list)
random.choice(list)

# =========================================
# TIME
# =========================================

time.wait(5)

time.timer_start(1)
time.timer_pause(1)
time.timer_stop(1)

let t = time.timer_read(1)

# =========================================
# OS
# =========================================

os.start(1)
os.run(1, "ls")

let out = os.run(1, "echo hello")

os(1).drop()

