# =========================================
# CLASSES
# =========================================

# A class is a self-contained object template.
# There is no 'self' keyword — class variables are
# accessed directly from inside the class.

class player() {

    let mut health: i32  = 100
    let mut name: str    = "unnamed"
    let mut scores: list = [0, 0, 0]

    fn greet() {
        print(i"Hi, I am {name}")
    }

    fn take_damage(amount: i32) {
        health = health - amount
    }

    fn reset_scores() {
        # Inside the class, collection fields are accessed directly
        # without the instance name — just like non-collection fields.
        scores(0).set(0)
        scores(1).set(0)
        scores(2).set(0)
        scores().add(0)
    }
}

# Create an instance:

let mut p = player()

# Read class fields:

print(p.health)   # 100

# Mutate a non-collection field using =:
# The instance must be declared with mut.

p.health = 80
p.name   = "Alice"

# Mutate a collection field using .set():
# From outside the class, prefix with the instance name.

p.scores(0).set(99)

# From inside a class method, access directly without the instance name.
# See reset_scores() in the class definition above.

# Append to a collection field using .add():

p.scores().add(50)

# Call a class method:

p.greet()
p.take_damage(10)

# Mutation rules:
# - If the instance is immutable (no mut), nothing can be changed.
# - If the instance is mutable (mut), only fields declared
#   with 'mut' inside the class can be changed.

class locked() {
    let value: i32 = 42     # can never be changed from outside
}

let mut obj = locked()
obj.value = 99   # ERROR: value is not declared mut

# -----------------------------------------
# CLASS MEMORY MODEL
# -----------------------------------------

# Class instances do not store their fields
# in the global memory pool.
# Each instance owns its own data.

let mut a = player()
let mut b = player()

a.health = 50

print(b.health) # 100

# Assigning one instance to another creates
# a complete deep copy.

let mut a = player()
let mut b = a

b.health = 10

print(a.health) # 100
print(b.health) # 10

# Classes can not access global memory unless link is used or passed through

# =========================================
# THREADING
# =========================================

# Rubidium supports real POSIX hardware threads.

use thread

fn task_one() {
    print("Task one done")
}

fn task_two() {
    print("Task two done")
}

fn run() {

    # thread(function(), id) — runs function asynchronously.
    # Thread IDs are integers, like timer IDs.
    # A thread ID can only be reused after that thread has finished.

    thread(task_one(), 1)
    thread(task_two(), 2)

    # thread.wait(id, ...) — blocks until all listed threads finish.

    thread.wait(1, 2)

    # thread.running(id) — returns True if the thread is still running.

    let still_going: bool = thread.running(1)
}

# Threading creates a scope with special rules.

fn task_one(x) {
    let local y = 10
    print("done")
}

let z = 10

fn main() {
    thread(task_one(1), 1)
    thread(task_one(1), 2)
}

# y is local, so each thread shares z but
# has its own x and y.

# -----------------------------------------
# THREAD SCOPE RULES
# -----------------------------------------

# Threads share the global memory pool.

# Any global variable can be read or modified

# by any thread.

let counter = 0

# All threads can access counter.

# -----------------------------------------
# THREAD-LOCAL DATA
# -----------------------------------------

# Function parameters and local variables

# belong only to the thread currently

# executing them.

fn worker(id) {
    let local temp = 10

    print(id)
    print(temp)
}

# Every thread receives its own copy of:

#

# - Function parameters

# - Local variables

# - Loop variables

# These values are never shared between

# threads.

# -----------------------------------------
# SHARED DATA
# -----------------------------------------

# Global variables are shared.

let total = 0

fn add() {
    total = total + 1
}

# If multiple threads modify the same global

# variable at the same time, the result is

# undefined.

# Rubidium provides no automatic race

# condition protection.

# -----------------------------------------
# AUTOMATIC CLEANUP
# -----------------------------------------

# When a thread finishes:
# - Function parameters are dropped
# - Local variables are dropped
# - Loop variables are dropped
# - Global variables remain alive.

# -----------------------------------------
# THREAD MEMORY MODEL
# -----------------------------------------

# Variable Type       Shared?

# Global Variable     Yes

# Function Parameter  No

# Local Variable      No

# Loop Variable       No

# File Handle         No

# Simple rule: If it is in the global pool, it is shared.
# Otherwise it belongs only to the currently executing thread.

