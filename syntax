# Imported files are isolated through namespaces.
# 'use' enables built-in compiler-provided modules.
# A module that is not declared with 'use' cannot be accessed.

use thread
use random
use time
use os
use FFI

# 'import' loads an external .rub file from the same folder into your code with the name of the file as the namespace

import math_tools

math_tools.sin(0.5)

# =========================================
# IMPORT ALIASES
# =========================================

# Imports can be renamed using 'as'.
# This creates a shorter namespace alias.

import math_tools as mt

mt.sin(0.5)

# The original namespace still exists.

math_tools.sin(0.5)

