# =========================================
# EXECUTION MODEL
# =========================================

# Rubidium runs in two phases:

# PHASE 1 — TOP LEVEL
#   Runs top to bottom before main().
#   Creates variables in the global pool.
#   Executes any function calls written at the top level immediately.
#   Defines functions and classes but does NOT run them.

# PHASE 2 — MAIN
#   After top level finishes, the compiler automatically runs fn main().

print("This runs first — top level")

fn main() {
    print("This runs second — main")
}

# =========================================
# MEMORY MODEL
# =========================================

# All variables live in a SHARED GLOBAL POOL.
#
# Rules:
# - Variables are visible everywhere once created.
# - There is no automatic memory management.
# - Memory must be freed manually using .drop().
# - The only exceptions are open() file blocks and loop variables,
#   which are freed automatically at the end of their block.
#
# Think of memory as a shared whiteboard —
# everyone can see and modify it.

# =========================================
# LANGUAGE PHILOSOPHY
# =========================================

# Rubidium is designed around simplicity,
# predictability, and explicit behavior.
# Many modern languages use garbage collection,
# ownership systems, reference counting,
# borrow checking, or other hidden mechanisms.
# Rubidium instead favors rules that are
# visible and easy to reason about.

# Rubidium favors behavior that is easy to
# understand over behavior that is heavily optimized.
# The language intentionally prioritizes
# clarity and consistency over maximum performance.

# =========================================
# DATA TYPES
# =========================================

# Integers (signed):
#   i32, i64, i128, i256, i512, i1024, i2048

# Floats:
#   f32, f64, f128, f256, f512, f1024, f2048

# Other:
#   str   — text string
#   str+  — a string but uses 3 " on each side
#   bool  — True or False
#   Null  — valid for all types, means "exists but empty"
#   Any   — can hold a value of any type
#   SY    — Holds a string that can be used in code

# Collections:
#   list
#   index
#   dict

let a: i32  = 100
let b: f64  = 3.14
let c: str  = "hello"
let d: bool = True
let e: i32  = Null
let f: Any  = "I can be anything!"

# Any can be used when you don't know the type in advance, for functions, return types and such

# =========================================
# GLOBAL BY DEFAULT
# =========================================

# Variables created normally are placed into the global memory pool.

let score = 100

# Global variables can be accessed anywhere.
# Local variables must be declared explicitly.

let local temp = 100

# Local variables never enter the global pool
# and are automatically dropped when their scope ends.

# =========================================
# THE DEEP COPY RULE
# =========================================

# Assigning one value to another creates a complete deep copy.

let mut a = [1, 2, 3]
let mut b = a

# a and b are completely independent.
# Rubidium does not use references,
# borrowing, or shared ownership.

# =========================================
# NULL BEHAVIOR
# =========================================

# Null is a valid value for every type.

let value: i32 = Null

# Null is considered smaller than every non-null value.
# Conceptually, Null behaves like negative infinity.

Null < 0         # True
Null < -999999   # True
Null == Null     # True

