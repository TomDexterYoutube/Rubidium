// Output:
// Hello!


let text = "World";

text.insert(0, "Hello ");

print(text);

// Output:
// Hello World


// Replace every matching character or string.

text.replace(old, new);

let mut text = "banana";

text.replace("a", "_");

print(text);

// Output:
// b_n_n_


let text = "Hello World";

text.replace("World", "Rubidium");

print(text);

// Output:
// Hello Rubidium


// Convert a string into a list of characters.

text.slice();

let text = "Hello";

print(text.slice());

// Output:
// ["H", "e", "l", "l", "o"]

