# -----------------------------------------
# Rubidium Programming Language Syntax
# File extension: .rub
# Designed for beginners. Built to scale into real systems programming.
# -----------------------------------------

# -------------------------------
# VARIABLES & DATA TYPES
# -------------------------------

# Declare variables with optional types.
#
# Integer types:
# i8, i16, i32, i64, i128, i256
#
# Floating-point types:
# f4, f8, f16, f32, f64, f128, f256
#
# Other built-in types:
# str   = String
# bool  = True / False

let x = 10                  # Type inferred as i32
let mut y: i32 = 5          # Mutable integer
let name: str = "Rubidium"
let mut f: f64 = 3.14
let mut b: bool = True

# Reassigning mutable variables
y = 15
f = 2.718
b = False

# Type casting using 'as'
let large_num: i64 = y as i64
let float_val: f64 = 100 as f64

# Variables are global by default.
# Functions, classes, and imported files create isolated scopes.

# -------------------------------
# TYPE CHECKING
# -------------------------------

# Rubidium performs compile-time type checking.
# Assigning the wrong type will raise a compiler error.

# Example (will error):
# let val: i32 = 5
# val = "hello"

# -------------------------------
# MATH & LOGIC
# -------------------------------

# Standard operators:
# +, -, *, /

# Operator precedence (BODMAS) applies
let calc1 = 1 + 2 * 3       # equals 7
let calc2 = (1 + 2) * 3     # equals 9

# Comparison operators:
# ==, !=, >, <, >=, <=

let check: bool = calc1 > 5

# Logical operators:
# and, or, not

let cond: bool = True and not False

# -------------------------------
# STRINGS & BUILT-IN METHODS
# -------------------------------

let greeting: str = "Hello, "
let target: str = "World!"

# String concatenation
# Returns a new heap-allocated string

let full_msg = greeting.combine(target)
let combined = greeting + target

# String methods

let length: i64 = full_msg.len()
let has_world: bool = full_msg.has("World")

let number_str: str = "404"
let num_val: i64 = number_str.to(i32)

# -------------------------------
# DYNAMIC COLLECTIONS
# (list, index, dict)
# -------------------------------

# Collections dynamically manage boxed memory internally.

# Lists start at index 1 instead of 0.
# This matches how humans naturally count sequences.

# 1. Lists (Arrays)

let my_list: list = ["64534", 2.124, "hi"]

print(my_list(3))             # prints: hi

# 2. Indexes
# Key-value collections with mixed key and value types

let my_index: index = [
    "one": "hello",
    2: "no",
    2.3: 123
]

print(my_index("one"))        # prints: hello

# 3. Dicts
# Structured key-value collections

let my_dict: dict = {
    "nested" = [1, "hi", 4],
    "no" = [1, 7, 4]
}

# Accessing nested collections

print(my_dict("nested", 2))   # prints: hi

# Mutating collections using .set()

my_list(2).set("why")
my_index("one").set("changed")
my_dict("nested", 1).set(99)

# -------------------------------
# PRINT & INPUT / OUTPUT
# -------------------------------

print(x)
print("Hello, Rubidium!")

# print() outputs text and moves to a new line.
#
# Example output:
#
# 10
# Hello, Rubidium!

println("Hi")
println(0)

# println() updates the current console line
# instead of creating a new one.
#
# Calling println() again replaces the previous
# text on that line.

# Example:
#
# println("Hi")
# println("Bye")
#
# Output:
#
# Bye

# You can also put varbables like this

print("Hello" + x)
# OR
print(i"Hello {x}"

# This also works with println

# Standard input

let user_input: str = input("Enter your name: ")

# File operations

file_write("data.txt", "Saving this to disk!")

let file_contents str = file_read("data.txt")

print(file_contents)

# "\n" creates a new line

# -------------------------------
# DEEP MEMORY DROPS
# -------------------------------

# .drop() frees memory immediately.
# The variable will no longer exist after being dropped.

x.drop()

# Collections and strings recursively free all
# nested boxes, arrays, and keys.

my_list.drop()
my_dict.drop()

# -------------------------------
# CONDITIONALS
# -------------------------------

if calc1 == 7 {
    print("True")
} else if calc1 > 10 {
    print("Else if")
} else {
    print("False")
}

# -------------------------------
# LOOPS & ITERATION
# -------------------------------

# While loop

let mut count = 0

while count < 5 {
    print(count)
    count = count + 1
}

# Numerical range loop

for i in range(1, 10) {

    if i == 5 {
        break
    }

    print(i)
}

# List iteration

let items: list = [10, 20, 30]

for item in items {
    print(item)
}

# Dict iteration
# Iteration returns the keys

let table: dict = {
    "a" = 100,
    "b" = 200
}

for key in table {

    let val = table(key)

    print(val)
}

# -------------------------------
# FUNCTIONS & SCOPING
# -------------------------------

# Function with parameters and return type

fn add(a: i32, b: i32) -> i32 {

    let local_var = a + b

    return local_var
}

# Calling a function

let math_result = add(2, 3)

# -------------------------------
# ERROR HANDLING
# -------------------------------

# try/error blocks

try {

    let fail: i32 = 10 / 0

} error {

    print("An error occurred" + error)
}

# The error block exposes the error as a string.

# -------------------------------
# CLASSES
# -------------------------------

# Classes are self-contained object structures.

class my_class() {

    let mut obj_val: i32 = 10

    fn my_func() {
        print("Hello from class!")
    }
}

# Creating and using a class instance

fn run_class() {

    let class_one = my_class()

    print(class_one.obj_val)

    class_one.obj_val.set(99)

    class_one.my_func()
}

# Inside a class there is no 'self'.
# Class variables are directly accessible
# from inside the class scope.

class my_class() {

    let x = 10
}

fn main() {

    let mut stuff = my_class()

    print(stuff.x)
}

# Mutation rules:
#
# - If the class instance is immutable,
#   all contained variables are immutable.
#
# - If the class instance is mutable,
#   only variables declared with 'mut'
#   can be changed.

# -------------------------------
# HARDWARE THREADING
# -------------------------------

# Rubidium supports real POSIX threading.

fn task1() {
    print("Task 1 Finished")
}

fn task2() {
    print("Task 2 Finished")
}

fn run_threads() {

    # thread(function(), thread_id)
    # runs the function asynchronously

    thread(task1(), 1)
    thread(task2(), 2)

    # Wait for specific threads to finish

    thread.wait(1, 2)
}

# -------------------------------
# RANDOM
# -------------------------------

# The built-in random module provides
# random number generation and utilities.

data = random(0, 1, f32)

# random(min, max, type)
#
# Example:
# random(0, 1, f32)

# Randomize list order

random.shuffle(my_list)

# Picks a random value or identifier

random.choice(my_list)
random.choice(my_index)

random.choice(my_dict)
random.choice(my_dict("my_idenifer"))

# -------------------------------
# WAIT / TIME
# -------------------------------

time.sleep(10)

# Waits for 10 seconds

# -------------------------------
# MODULES & IMPORTS
# -------------------------------

# Use 'use' to enable compiler-provided modules.

use thread
use random
use time

# If a module is not included with 'use',
# it cannot be accessed.

# Use 'import' to load external .rub files

import math_tools

# -------------------------------
# MAIN ENTRY POINT
# -------------------------------

# The compiler always looks for main()
# as the program entry point.

fn main() {

    print("Welcome to Rubidium!")

    run_class()
    run_threads()
}

# -------------------------------
# NOTES
# -------------------------------

# - Statements end with a newline
# - Semicolons are not required
# - Variables can be mutable or immutable
# - Functions support optional return types
# - Math follows standard precedence rules
# - if / else and loops use braces { }
# - Strings use double quotes
# - .drop() immediately frees memory
# - Type checking happens at compile time
# - Boolean values are True and False
# - Logical operators are and, or, and not
# - Error handling uses try/error blocks
