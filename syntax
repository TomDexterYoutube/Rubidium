# =========================================
# COLLECTIONS
# =========================================

# All three collection types (list, index, dict)
# require 'mut' if you want to modify them.

# -----------------------------------------
# LIST
# -----------------------------------------

# An ordered sequence. Zero-indexed.

let mut my_list: list = ["hello", 2.5, True]

# Access by index:

print(my_list(0))   # hello

# Mutate an item using .set():

my_list(0).set("changed")

# Append a new item using .add():

my_list().add("new_item")

# when a list is printed it shows text in "" and everything else as is
let my_list = "Hello".slice() + [1, 2, 3]
print(my_list) # ["H", "e", "l", "l", "o", 1, 2, 3]

# -----------------------------------------
# LIST UTILITIES
# -----------------------------------------

# .combine() joins all values together.

let words = ["Hello", " ", "World"]

print(words.combine())

# Output:
# Hello World

# -----------------------------------------
# INDEX
# -----------------------------------------

# A flat key-value map.
# Keys can be any type. Values must be a single SCALAR (i32/f64/str/bool/
# Null/etc) — never a list, index, dict, or dict+. Use `dict` instead if a
# key needs to hold a collection of values.

let mut my_index: index = [
    "name": "Rubidium",
    1: "one",
    2.5: "float key"
]

# Access by key:

print(my_index("name"))   # Rubidium

# Mutate a value using .set():

my_index("name").set("updated")

# Add a new key-value pair using .add():
# If the key already exists, this will error.

my_index().add("new_key", 99)

# -----------------------------------------
# DICT
# -----------------------------------------

# A key-value map where each key holds
# a collection of multiple values.

let mut my_dict: dict = {
    "scores" = [10, 20, 30],
    "names"  = ["alice", "bob"]
}

# Access a specific value inside a key:
# dict(key, index)

print(my_dict("scores", 1))   # 20

# Mutate a value using .set():

my_dict("scores", 1).set(999)

# Add a value to an existing key's collection:

my_dict("scores").add(40)

# Add a new top-level key:
# The new key is created with value Null.

my_dict().add("new_key")

# -----------------------------------------
# DICT+
# -----------------------------------------

# dict+ is like dict, but a key's value can be
# either a list (a leaf, same as normal dict)
# or another dict+ (a further level of nesting).
# There is no limit on how many levels deep this can go.

let mut my_dictplus: dict+ = {
    1 = {
        "test" = [1, 2, 3, 4]
    }
}

# Access a value by chaining keys down through each level:
# dictplus(key1, key2, ...) — keeps drilling down until
# it reaches a list, then behaves like a normal dict from there.

print(my_dictplus(1, "test"))          # [1, 2, 3, 4]
print(my_dictplus(1, "test", 0))       # 1

# Add a value to the list at the end of the path:

my_dictplus(1, "test").add("ten")

# Add a new key at any level.
# Give it a list to make it a leaf, or a { } block to nest further:

my_dictplus(1).add("other", [5, 6, 7])
my_dictplus(1).add("deeper", { "layer2" = [8, 9] })

# Add a new top-level key:
# The new key is created as an empty dict+.

my_dictplus().add(2)

# -----------------------------------------
# NAMING NOTE
# -----------------------------------------

# Keys still follow the same rules as index/dict —
# strings need quotes ("test"), numbers and other
# types do not.

