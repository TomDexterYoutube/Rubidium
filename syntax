# =========================================
# FILES
# =========================================

# Open a file using 'open() as'.
# The file automatically closes at the end of the block.
# Any variables created inside the block persist,
# but the file handle is gone after the closing brace.

open("data.txt") as file {

    file.write("Hello")        # overwrite entire file
    file.add(" World")         # add to end of file

    let data = file.read()     # read entire file (would be the str+ type)
    print(data)

    let line = file.readln(3)  # read a specific line
    print(line)

    file.writeln(2, "Updated") # overwrite a specific line
}

# Line indexing starts at 0
# Iterate over a file line by line:

open("data.txt") as file {
    for line in file {
        print(line)
    }
}

# If the file does not exist, open() creates it, raises a
# (non-fatal, catchable) error, and then continues.

# File utility functions (used outside of open blocks):

file.exists("data.txt")              # returns bool
file.new("data.txt")                 # create a new file
file.delete("old.txt")               # delete a file
file.rename("old.txt", "new.txt")    # rename a file
file.copy("save.txt", "backup.txt")  # copy a file
file.list("data/")                   # used like linux ls command

# File errors can be caught with try/error:

try {
    open("missing.txt") as file {
        print(file.read())
    }
} error {
    print("File error: " + error)
}

# missing.txt is created either way — the try/error block
# just lets you catch and handle the "file did not exist" error.

