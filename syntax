# -----------------------------------------
# Rubidium Programming Language Syntax
# File extension: .rub
#
# Goal:
# - Python-style readability
# - Rust-style performance
# - Simple syntax
# - Compiled language
# -----------------------------------------



# =====================================================
# VARIABLES & DATA TYPES
# =====================================================

# Variables store data in memory.

# "let" creates an immutable variable.
# Immutable means the value cannot change later.

let age: i32 = 17

println(age)

# Output:
# 17


# "mut" allows the variable to be changed.

let mut score: i32 = 10

score = 25

println(score)

# Output:
# 25


# -----------------------------------------------------
# BASIC DATA TYPES
# -----------------------------------------------------

# Integer numbers
let integer: i32 = 42

# Large integer
let big_number: i64 = 999999999

# Decimal numbers
let pi: f32 = 3.14

# More precise decimal
let precise_pi: f64 = 3.1415926535

# Single character
let letter: char = 'A'

# Text/string
let message: str = "Hello"

# True or false
let online: bool = true

# Empty value
let nothing: none = none


# =====================================================
# PRINTING
# =====================================================

# print() stays on the same line.

print("Hello ")
print("World")

# Output:
# Hello World


# println() adds a new line after printing.

println("Hello")
println("World")

# Output:
# Hello
# World


# Formatted strings using f"..."

let name: str = "Max"

println(f"Hello {name}")

# Output:
# Hello Max



# =====================================================
# OPERATORS
# =====================================================

# Operators perform math or comparisons.

# -----------------------------------------------------
# MATH OPERATORS
# -----------------------------------------------------

let add: i32 = 5 + 2
println(add)

# Output:
# 7


let subtract: i32 = 10 - 3
println(subtract)

# Output:
# 7


let multiply: i32 = 4 * 5
println(multiply)

# Output:
# 20


let divide: f32 = 10 / 2
println(divide)

# Output:
# 5


let modulo: i32 = 10 % 3
println(modulo)

# Output:
# 1


# -----------------------------------------------------
# COMPARISON OPERATORS
# -----------------------------------------------------

println(5 == 5)

# Output:
# true


println(5 != 3)

# Output:
# true


println(10 > 2)

# Output:
# true


println(1 < 5)

# Output:
# true


# -----------------------------------------------------
# LOGICAL OPERATORS
# -----------------------------------------------------

println(true and false)

# Output:
# false


println(true or false)

# Output:
# true


println(not true)

# Output:
# false



# =====================================================
# CONDITIONS
# =====================================================

# if statements run code only if a condition is true.

let temperature: i32 = 30

if temperature > 25 {
    println("Hot")
} elif temperature > 15 {
    println("Warm")
} else {
    println("Cold")
}

# Output:
# Hot



# =====================================================
# LOOPS
# =====================================================

# -----------------------------------------------------
# WHILE LOOP
# -----------------------------------------------------

# Repeats while condition is true.

let mut x: i32 = 0

while x < 3 {

    println(x)

    x += 1
}

# Output:
# 0
# 1
# 2


# -----------------------------------------------------
# FOR LOOP
# -----------------------------------------------------

# range(start, end)

for i in range(0, 5) {

    println(i)
}

# Output:
# 0
# 1
# 2
# 3
# 4


# -----------------------------------------------------
# LOOP
# -----------------------------------------------------

# Infinite loop until break.

let mut counter: i32 = 0

loop {

    println(counter)

    counter += 1

    if counter == 3 {
        break
    }
}

# Output:
# 0
# 1
# 2



# =====================================================
# FUNCTIONS
# =====================================================

# Functions store reusable code.

fn greet(name: str) {

    println(f"Hello {name}")
}

greet("Max")

# Output:
# Hello Max


# Function with return value.

fn add(a: i32, b: i32) -> i32 {

    return a + b
}

let result: i32 = add(5, 3)

println(result)

# Output:
# 8


# Anonymous function (lambda)

let square = fn(x: i32) -> i32 {

    return x * x
}

println(square(4))

# Output:
# 16



# =====================================================
# LISTS / ARRAYS
# =====================================================

# Lists store multiple values.

let numbers: list = [1, 2, 3]

println(numbers[0])

# Output:
# 1


# Add item
numbers.push(4)

println(numbers)

# Output:
# [1, 2, 3, 4]


# Remove last item
numbers.pop()

println(numbers)

# Output:
# [1, 2, 3]



# =====================================================
# DICTIONARIES
# =====================================================

# Dictionaries store key/value pairs.

let user: dict = {

    "name": "Max",
    "age": 17
}

println(user["name"])

# Output:
# Max


println(user["age"])

# Output:
# 17



# =====================================================
# STRUCTS
# =====================================================

# Structs group related data together.

struct Player {

    name: str
    health: i32
}

let player: Player = Player {

    name: "Steve",
    health: 100
}

println(player.name)

# Output:
# Steve


println(player.health)

# Output:
# 100



# =====================================================
# CLASSES
# =====================================================

# Classes contain variables and functions.

class Animal {

    let mut name: str = "Dog"

    fn speak(self) {

        println("Bark")
    }
}

let pet: Animal = Animal()

pet.speak()

# Output:
# Bark



# =====================================================
# THREADING
# =====================================================

# spawn runs code on another thread.

fn task() {

    println("Running on another thread")
}

spawn task()

# Output:
# Running on another thread



# =====================================================
# FILES
# =====================================================

# Open file in write mode.

let file: file = open("test.txt", "w")

file.write("Hello")

file.close()

# File content:
# Hello



# =====================================================
# ERROR HANDLING
# =====================================================

# try/catch prevents crashes.

try {

    let result: i32 = 10 / 0

} catch err {

    println("Error happened")
}

# Output:
# Error happened



# =====================================================
# MODULES
# =====================================================

# use imports standard library modules.

use math

# import imports local user files.

import player



# =====================================================
# MEMORY MANAGEMENT
# =====================================================

# drop() manually frees memory.

let data: str = "Temporary Data"

drop(data)



# =====================================================
# MATCH STATEMENTS
# =====================================================

# Similar to switch statements.

let number: i32 = 2

match number {

    1 => println("One")
    2 => println("Two")
    _ => println("Other")
}

# Output:
# Two



# =====================================================
# ENUMS
# =====================================================

# Enums store a fixed set of values.

enum Direction {

    Up
    Down
    Left
    Right
}

let direction: Direction = Direction.Up

println(direction)

# Output:
# Up



# =====================================================
# COMMENTS
# =====================================================

# Single line comment


/*
Multi-line
comment
*/



# =====================================================
# STRING OPERATIONS
# =====================================================

let first: str = "Rubi"
let second: str = "dium"

let combined: str = first + second

println(combined)

# Output:
# Rubidium



# =====================================================
# TYPE CASTING
# =====================================================

# Convert one type into another.

let text_number: str = "42"

let converted: i32 = int(text_number)

println(converted + 1)

# Output:
# 43



# =====================================================
# ASYNC
# =====================================================

# Async functions allow non-blocking code.

async fn fetch_data() {

    println("Fetching data...")
}

await fetch_data()

# Output:
# Fetching data...



