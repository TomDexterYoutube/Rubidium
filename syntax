# -----------------------------------------
# Rubidium Programming Language Syntax
# File extension: .rub
# Designed for beginners. Built to scale into real systems programming.
# -----------------------------------------

# =========================================
# OVERVIEW (READ THIS FIRST PLEASE)
# =========================================

# Rubidium is a systems-level programming language
# with a beginner-friendly surface syntax.

# The most important mental model:
#
# VARIABLES LIVE IN A SHARED POOL.
#
# This means:
# - Variables are NOT confined to function scope
# - Variables exist once created
# - Variables persist until explicitly dropped
# - Functions only control WHEN variables are created

# Example mental model:
#
# Think of memory like a public whiteboard.
# Anyone can see it.
# Anyone can write on it (if mutable).
# Only `.drop()` erases it completely.

# =========================================
# EXECUTION ORDER (VERY IMPORTANT)
# =========================================

# 1. Top-level code runs first (top to bottom)
# 2. Functions are defined but NOT executed yet
# 3. main() runs automatically after top-level execution

print("A - top level")

fn main() {
    print("B - main")
}

# OUTPUT:
# A - top level
# B - main

# =========================================
# VARIABLES
# =========================================

# Variables are created when execution reaches them.

let x = 10
let name = "Rubidium"
let flag = True

# These variables immediately enter the global pool.

print(x)
print(name)
print(flag)

# OUTPUT:
# 10
# Rubidium
# True

# -----------------------------------------
# MUTABLE VARIABLES
# -----------------------------------------

let mut counter = 0

counter = 1
counter = 2
counter = 3

print(counter)

# OUTPUT:
# 3

# -----------------------------------------
# IMMUTABLE VARIABLES
# -----------------------------------------

let locked = 10

locked = 20   # WARNING: not mutable

# Compiler behavior:
# - warning or error depending on compiler strict mode
# - value is NOT changed

# =========================================
# VARIABLE POOL MODEL (CORE FEATURE)
# =========================================

# Variables exist in a shared runtime pool.

fn create() {
    let x = 99
}

create()

print(x)

# OUTPUT:
# 99

# Explanation:
# - function executed
# - variable inserted into pool
# - variable remains after function ends

# =========================================
# DELETION SYSTEM (.drop)
# =========================================

let temp = 123

print(temp)

temp.drop()

print(temp)

# OUTPUT:
# 123
# ERROR: variable does not exist

# -----------------------------------------
# DROP BEHAVIOR DETAILS
# -----------------------------------------

# .drop() permanently removes variable
# - removes value
# - removes references
# - removes memory
# - cannot be recovered

let list = [1,2,3]
list.drop()

# list is gone completely

# =========================================
# COPYING RULE (VERY IMPORTANT)
# =========================================

# All assignments are DEEP COPIES

let a = [1,2,3]
let b = a

b(0).set(999)

print(a)

# OUTPUT:
# [1,2,3]

# Explanation:
# - a and b are fully independent
# - modifying b does NOT affect a

# =========================================
# TYPES
# =========================================

let a: i32 = 10
let b: i64 = 100
let c: f32 = 3.14
let d: f64 = 2.718
let e: str = "hello"
let f: bool = True

# -----------------------------------------
# TYPE LIST (EXTRA DETAIL)
# -----------------------------------------

# Integers:
# i32   - small integer
# i64   - standard integer
# i128  - large integer
# i256  - very large integer
# i512  - extremely large integer
# i1024 - massive integer
# i2048 - absurd integer used for simulation / math / experiments

# Floats:
# f32   - fast decimal
# f64   - standard float
# f128  - high precision
# f256  - scientific precision
# f512  - simulation grade
# f1024 - extreme precision
# f2048 - theoretical precision (rare use)

# =========================================
# CASTING
# =========================================

let x = 10

let a = x as i64
let b = x as f32
let c = x as str

let s = "123"
let n = s.to(i32)
let f = s.to(f64)

# =========================================
# MATH
# =========================================

let a = 10 + 5
let b = 10 - 5
let c = 10 * 5
let d = 10 / 5
let e = 2 ** 3

# Square root operator
let f = */16

# Explanation:
# */ means "square root"
# so */16 = 4

# -----------------------------------------
# NEGATIVE VALUES
# -----------------------------------------

let x = 10
let y = -x

# =========================================
# STRINGS (VERY DETAILED)
# =========================================

let a = "Hello"
let b = "World"

# concatenation
let c = a + b

# method style concatenation
let d = a.combine(b)

# length
let len = a.len()

# contains check
