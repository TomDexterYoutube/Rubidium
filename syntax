# =========================================
# BREAK & CONTINUE
# =========================================

# break exits the loop immediately.

for i in range(1, 10) {
    if i == 5 {break}
    print(i)
}

# continue skips the current iteration.

for i in range(1, 10) {
    if i == 5 {continue}
    print(i)
}

# =========================================
# FUNCTIONS
# =========================================

# Functions share the global memory pool.

# Function parameters are local to the function
# and are automatically dropped when the function returns.

# Basic function:

fn greet() {
    print("Hello!")
}

# With parameters:

fn add(a: i32, b: i32) -> i32 {
    return a + b
}

let result = add(2, 3)   # 5

# Return type is optional.
# A function with no return type returns nothing.

fn log(msg: str) {
    print(i"[LOG] {msg}")
}

# =========================================
# The Link Rule
# =========================================

# Say you have a variable that is a local val and it is large
# And you want another function to use it but you don't want to deep copy the large value
# Then use link

fn stuff(val: Any) -> Any {
    val.add(7)

fn main() {
    let local large_list: list = ["Lots of Data"]
    stuff(link large_list)
}

# This would let the function stuff access the local variable without a deep copy
# Both functions are now using the same variable both have full access if it is mut both can edit it

# If you love pain (rust) then you can use link for variables

let a = 10

let b = link a

# Now if a changes then b will change but if b changes without a then they become unlinked
# then become there own variable in memory this also works for lists

let x = [1, 2, 3]
let y = link x(2)

# or

let x = [1, 2, 3]
let y = link x

# =========================================
# ERROR HANDLING
# =========================================

# Use try/error to catch runtime errors.
# The error variable holds the error message as a str+.

try {
    let bad: i32 = 10 / 0
} error {
