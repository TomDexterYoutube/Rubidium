use thread

fn test1() {
    for i in range(1,1000) {
        let mut x i32 = 10
        x = x * 10
    }
}

fn test2() {
    for i in range(1,100) {
        let mut y i32 = 10
        y = y * 10
    }
    return y
}

fn main() {
    thread(test1(), 1)
    let stuff = thread(test2(), 2)
    thread.wait(1)
    print(stuff)
    print(1)
}
